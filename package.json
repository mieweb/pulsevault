{
  "name": "@mieweb/pulsevault",
  "version": "0.3.0",
  "description": "Resumable video uploads via TUS for Fastify (plugin) or any Node backend (framework-agnostic core), with a pluggable storage adapter and a filesystem-first local-storage default.",
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./augment": {
      "types": "./dist/augment.d.ts",
      "import": "./dist/augment.js",
      "default": "./dist/augment.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "core.js",
    "core.d.ts",
    "augment.js",
    "augment.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PROTOCOL.md",
    "OPERATIONS.md",
    "scripts/web-ready-migrate.mjs",
    "protocol"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "e2e": "npm run build && node scripts/e2e-tus.mjs",
    "protocol": "npm run build && node scripts/gen-protocol.mjs",
    "protocol:check": "npm run build && node scripts/gen-protocol.mjs --check",
    "protocol:compat": "node scripts/check-protocol.mjs"
  },
  "keywords": [
    "fastify",
    "fastify-plugin",
    "express",
    "meteor",
    "tus",
    "tus-server",
    "video",
    "upload",
    "resumable",
    "pulsevault"
  ],
  "author": "Medical Informatics Engineering, Inc.",
  "contributors": [
    "morepriyam (https://github.com/morepriyam)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/pulsevault.git"
  },
  "bugs": {
    "url": "https://github.com/mieweb/pulsevault/issues"
  },
  "homepage": "https://github.com/mieweb/pulsevault#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "fastify": "^5.12.1"
  },
  "dependencies": {
    "@fastify/send": "^4.1.1",
    "@tus/file-store": "2.0.0",
    "@tus/server": "2.0.0",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@tus/s3-store": "^2.0.6"
  },
  "pulseProtocol": {
    "version": "2.1",
    "min": 2,
    "max": 2
  }
}
