{
  "name": "@mieweb/pulsevault",
  "version": "0.3.0",
  "description": "Resumable video uploads via TUS for any Node backend — framework-agnostic core with a filesystem-first local adapter, an S3/R2 adapter with presigned playback, and a first-party Fastify plugin adapter.",
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "default": "./dist/fastify.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./augment": {
      "types": "./dist/augment.d.ts",
      "import": "./dist/augment.js",
      "default": "./dist/augment.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "core.js",
    "core.d.ts",
    "fastify.js",
    "fastify.d.ts",
    "web.js",
    "web.d.ts",
    "augment.js",
    "augment.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PROTOCOL.md",
    "OPERATIONS.md",
    "scripts/web-ready-migrate.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "e2e": "npm run build && node scripts/e2e-tus.mjs"
  },
  "keywords": [
    "fastify",
    "fastify-plugin",
    "express",
    "meteor",
    "tus",
    "tus-server",
    "video",
    "upload",
    "resumable",
    "pulsevault"
  ],
  "author": "Medical Informatics Engineering, Inc.",
  "contributors": [
    "morepriyam (https://github.com/morepriyam)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/pulsevault.git"
  },
  "bugs": {
    "url": "https://github.com/mieweb/pulsevault/issues"
  },
  "homepage": "https://github.com/mieweb/pulsevault#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "fastify": "^5.12.1"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/send": "^4.1.1",
    "@tus/file-store": "2.0.0",
    "@tus/server": "2.0.0",
    "fastify-plugin": "^5.1.0",
    "range-parser": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.6",
    "@types/range-parser": "^1.2.7",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@tus/s3-store": "^2.0.6"
  }
}
